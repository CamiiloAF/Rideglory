          "fontFamily": "Outfit",
          "fontSize": 12,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "V2lyET",
          "name": "Precio",
          "fill": "#B91C1C",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "PRECIO · la pantalla es más larga y depende de scroll; al perder los encabezados VENCIDO / ESTE MES, la urgencia queda solo en el color, que hay que verificar bajo sol.",
          "lineHeight": 1.4,
          "fontFamily": "Outfit",
          "fontSize": 12,
          "fontWeight": "600"
        }
      ]
    },
